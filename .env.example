# Copy to .env and fill in real values. Never commit .env.

# Signs/verifies the session cookie AND wraps source connection strings
# (HKDF-SHA256 → AES-256-GCM). Use a long random string. Rotating this
# invalidates stored DSNs until they are pasted again in /admin/sources.
SESSION_SECRET=

# Local SQLite file for panel app state (users, roles, settings, sources).
# On Railway/Docker, mount a persistent volume at /app/data and keep this path.
PANEL_DB_URL=file:./data/panel.db

# Optional. Steam64 of the first owner on a fresh DB. On login, that SteamID
# is promoted to role `owner` (does not demote anyone else). Remove or leave
# set after bootstrap — either is fine.
# OWNER_STEAM_ID=76561198000000000

# Steam OpenID / Web API.
STEAM_API_KEY=
STEAM_REALM=http://localhost:5173
STEAM_RETURN_URL=http://localhost:5173/api/auth/return

# Game data sources are managed from /admin/sources. Paste a mysql:// URL
# there. Connection strings are not environment variables.

# Voice reconstruction (staff module). Optional — defaults work for local/Docker.
# Absolute path to the voice-processor binary (default: voice-processor on PATH).
# Docker/Railway use the bundled Linux binary at /usr/local/bin/voice-processor.
# Local Windows example:
# VOICE_PROCESSOR_PATH=C:\path\to\steam-audio-codec\target\release\voice-processor.exe
# VOICE_PROCESSOR_PATH=
# Root directory for uploaded demos + extracted WAVs (default: <panel data dir>/voice).
# VOICE_DATA_DIR=
# adapter-node multipart body limit (default 512K is too small for .dem uploads).
BODY_SIZE_LIMIT=200M
