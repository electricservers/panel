# Copy to .env and fill in real values. Never commit .env.

# Signs/verifies the session cookie. Use a long random string.
SESSION_SECRET=

# Local SQLite file for panel app state (users, roles, settings).
PANEL_DB_URL=file:./data/panel.db

# Steam OpenID / Web API.
STEAM_API_KEY=
STEAM_REALM=http://localhost:5173
STEAM_RETURN_URL=http://localhost:5173/api/auth/return

# Game data sources are managed from /admin/sources (SQLite), not env vars.
# Each source row only stores a `dsnEnv` pointer; the real MySQL URL still
# lives in its own env var below and is never written to the DB.
SOURCE_ELECTRIC_AR_URL=
SOURCE_ELECTRIC_BR_URL=

# One-time bootstrap only: if you're migrating from the old PANEL_SOURCES
# env var, set it here temporarily and run `bun run scripts/import-panel-sources.ts`
# once, then delete this line. Unused otherwise.
# PANEL_SOURCES=[{"id":"electric-ar","label":"Argentina","dsnEnv":"SOURCE_ELECTRIC_AR_URL","capabilities":["mgemod","whois"],"enabled":true}]
